SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=alliance_supply
DB_USER=alliance_supply
DB_PASSWORD=alliance_supply
DB_HOST=db
DB_PORT=5432

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Console backend just prints emails to the celery-worker container logs.
# Point these at a real SMTP provider for production.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=quartermaster@alliance-supply.example
ALLIANCE_COMMAND_EMAIL=command@alliance-supply.example

# Free-tier deployment only (config.settings.prod) -- unused locally.
# Shared secret the external cron (GitHub Actions) sends to trigger the
# low-stock digest in place of Celery Beat. Leave blank locally; the
# endpoint refuses every request while this is empty. See README > Despliegue.
CRON_SECRET=
